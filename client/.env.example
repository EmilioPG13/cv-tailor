# Copy to .env and fill in. Never commit the real .env — it is gitignored.
#
# Anything prefixed VITE_ is inlined into the client bundle and is therefore
# public. Only publishable keys belong here — never a secret or service-role key.

# Base URL of the backend, e.g. http://localhost:3001 in development.
VITE_API_URL=

# Clerk publishable key — the same one the server uses as CLERK_PUBLISHABLE_KEY.
VITE_CLERK_PUBLISHABLE_KEY=
