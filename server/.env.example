# Copy to .env and fill in. Never commit the real .env — it is gitignored.

# NVIDIA NIM (build.nvidia.com) — powers the tailoring and design calls.
NVIDIA_API_KEY=

# Supabase. The service-role key bypasses row-level security, so it must stay
# server-side and must never be exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (clerk.com) — authentication.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Firecrawl (firecrawl.dev) — optional, only needed for the URL scraping feature.
FIRECRAWL_API_KEY=

# Allowed CORS origin. Defaults to http://localhost:5173 when unset; in
# production set this to the deployed frontend URL.
FRONTEND_URL=

# Defaults to 3001 when unset.
PORT=
